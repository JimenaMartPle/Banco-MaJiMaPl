<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnTertiaryContainer"
    tools:context=".AccountsMovementsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/movimientosTit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:padding="@dimen/basicSpace"
            android:text="@string/opButText2"
            android:textAlignment="center"
            android:textColor="?attr/colorTertiaryContainer"
            android:textSize="@dimen/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/detallesSubtit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/basicSpace"
            android:padding="@dimen/basicSpace"
            android:text="@string/detallesSubtit"
            android:textColor="?attr/colorTertiaryContainer"
            android:textSize="@dimen/subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/movimientosTit" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMovimientos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/doubleBasicSpace"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detallesSubtit"
            app:layout_constraintVertical_bias="0.0"
            tools:listitem="@layout/item_movimiento" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>