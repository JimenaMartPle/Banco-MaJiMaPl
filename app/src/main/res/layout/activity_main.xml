<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/doubleBasicSpace"
        android:paddingBottom="85dp">

        <!-- Card 1: Nombre del banco -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bankNameCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/basicSpace"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bankName"
                    android:fontFamily="@font/rocksalt_regular"
                    android:letterSpacing="0.05"
                    android:textAlignment="center"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/nameBankSize"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Bienvenida -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/welcomeCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorTertiary"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:layout_constraintTop_toBottomOf="@id/bankNameCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImg"
                    android:layout_width="@dimen/avatarImg"
                    android:layout_height="@dimen/avatarImg"
                    android:src="@drawable/avatar_girl"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/esquinasRedondeadas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/welcomeMsg"
                    android:layout_width="100dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/mainWelcome"
                    android:textAlignment="center"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/avatarImg"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Bienvenidx, 11223344G" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Operacioes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/operacionesCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:layout_constraintTop_toBottomOf="@id/welcomeCard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton1"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText1"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_posicionglobal"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton2"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText2"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_movimientos"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton3"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText3"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_transferencias"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton2"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton4"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText4"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_cambiarcont"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton3"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton5"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText5"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_promo"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton4"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton6"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText6"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_cajeros"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton5"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/opButton7"
                        android:layout_width="@dimen/opButtonWidth"
                        android:layout_height="@dimen/opButtonHeight"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="@dimen/basicSpace"
                        android:text="@string/opButText7"
                        android:textSize="@dimen/opButtonText"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:icon="@drawable/ic_salir"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/opButton6"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BottomBar -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        style="@style/Widget.MaterialComponents.BottomAppBar.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:navigationIcon="@drawable/ic_menu"
        app:fabAlignmentMode="center"
        app:fabAnimationMode="scale"
        app:fabCradleMargin="@dimen/basicSpace"
        app:fabCradleRoundedCornerRadius="16dp"
        app:fabCradleVerticalOffset="10dp"
        app:backgroundTint="?attr/colorOnTertiaryContainer"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bank"
        android:contentDescription="@string/bank"
        app:backgroundTint="?attr/colorTertiary"
        app:tint="?attr/colorOnTertiary"
        app:shapeAppearanceOverlay="@style/FabEsquinasRedondeadas"
        app:layout_anchor="@id/bottomAppBar"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>